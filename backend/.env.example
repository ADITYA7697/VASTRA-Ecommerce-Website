PORT=5000
NODE_ENV=development
# Local MongoDB if its port is published to your computer:
MONGO_URI=mongodb://127.0.0.1:27017/vastra
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Browser session cookie (HttpOnly) ---------------------------------------
# Local dev (same site, http): defaults are fine. In production behind HTTPS:
#   NODE_ENV=production makes the cookie Secure automatically.
# If the storefront is on a DIFFERENT SITE than the API (e.g. shop.example.com vs api.other.com) use:
#   COOKIE_SAMESITE=none  and  COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true
# Set when running behind a reverse proxy/load balancer so rate limits see real client IPs (e.g. 1)
# TRUST_PROXY=1

# --- Mobile OTP limits (per phone number; Twilio Verify also enforces its own) ---
OTP_RESEND_COOLDOWN_SEC=30
OTP_MAX_SENDS_PER_HOUR=5
OTP_MAX_FAILED_CHECKS=5
# Set to the exact browser origin of your frontend:
FRONTEND_ORIGIN=http://127.0.0.1:5500,http://localhost:5500,http://localhost:5000,http://127.0.0.1:5000
ADMIN_NAME=VASTRA Admin
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_12_PLUS_CHARACTER_PASSWORD

# Google Identity Services (OAuth Web Client ID; never put client secrets in frontend code)
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# Twilio Verify (SMS OTP) — REQUIRED for mobile signup/login. Keep all values private in backend/.env.
# Twilio generates/stores/expires the code; VASTRA never stores an OTP. India SMS may need DLT registration — see README.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_VERIFY_SERVICE_SID=your-twilio-verify-service-sid


# Razorpay: use TEST keys first; never expose KEY_SECRET in frontend or commit .env
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_razorpay_test_secret
